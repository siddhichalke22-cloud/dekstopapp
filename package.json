{
	"name": "desktop-workspace",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "electron/main.js",
	"scripts": {
		"dev": "concurrently -k -n web,api,desktop \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:desktop\"",
		"dev:web": "vite --host 127.0.0.1",
		"dev:api": "node --watch server/src/server.js",
		"dev:desktop": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
		"build": "vite build",
		"start:api": "node server/src/server.js",
		"db:push": "prisma db push --schema server/prisma/schema.prisma",
		"db:studio": "prisma studio --schema server/prisma/schema.prisma",
		"postinstall": "prisma generate --schema server/prisma/schema.prisma"
	},
	"dependencies": {
		"@prisma/client": "^6.19.0",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"lucide-react": "^0.468.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.28.1"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^9.1.2",
		"cross-env": "^7.0.3",
		"electron": "^33.2.1",
		"prisma": "^6.19.0",
		"vite": "^6.0.5",
		"wait-on": "^8.0.1"
	}
}
