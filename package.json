{
	"name": "desktop-workspace",
	"productName": "SkillBridge",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "electron/main.js",
	"scripts": {
		"dev": "node scripts/dev.js",
		"dev:web": "vite --host 127.0.0.1",
		"dev:api": "node --watch server/src/server.js",
		"dev:desktop": "wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
		"build:web": "vite build",
		"build:backend": "prisma generate && node scripts/build-backend.js",
		"build": "npm run build:web && npm run build:backend",
		"build:desktop": "npm run build && electron-builder",
		"dist:mac": "npm run build && electron-builder --mac",
		"dist:win": "npm run build && electron-builder --win",
		"dist:linux": "npm run build && electron-builder --linux",
		"start:api": "node server/src/server.js",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"db:generate": "prisma generate",
		"postinstall": "prisma generate",
		"start": "electron ."
	},
	"devDependencies": {
		"@prisma/adapter-pg": "^7.0.0",
		"@prisma/client": "^7.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"bcryptjs": "^3.0.2",
		"cors": "^2.8.5",
		"concurrently": "^9.1.2",
		"cross-env": "^7.0.3",
		"dotenv": "^16.4.7",
		"electron": "^33.2.1",
		"electron-builder": "^26.18.0",
		"esbuild": "^0.25.0",
		"express": "^4.21.2",
		"jsonwebtoken": "^9.0.2",
		"lucide-react": "^0.468.0",
		"pg": "^8.16.3",
		"prisma": "^7.0.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.28.1",
		"vite": "^6.0.5",
		"wait-on": "^8.0.1"
	},
	"build": {
		"appId": "edu.skillbridge.desktop",
		"productName": "SkillBridge",
		"asar": true,
		"directories": {
			"output": "release"
		},
		"electronLanguages": ["en-US"],
		"files": [
			"dist/**/*",
			"electron/**/*",
			"package.json"
		],
		"extraResources": [
			{
				"from": "dist/backend/server.cjs",
				"to": "backend/server.cjs"
			},
			{
				"from": ".env.example",
				"to": ".env.example"
			}
		],
		"mac": {
			"target": ["dmg", "zip"]
		},
		"win": {
			"target": ["nsis"]
		},
		"linux": {
			"target": ["AppImage"]
		}
	}
}
